{
  "name": "api-server",
  "version": "0.5.0",
  "description": "API backend service with REST based on Nest.js and TypeORM",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "github:fwmakc/api-server"
  },
  "keywords": [
    "nestjs",
    "rest-api",
    "crud",
    "typeorm",
    "swagger"
  ],
  "bugs": {
    "url": "https://github.com/fwmakc/api-server/issues"
  },
  "homepage": "https://github.com/fwmakc/api-server#readme",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "debug": "nest start --debug --watch",
    "prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "ai-context": "node node_modules/api-server-toolkit/scripts/generate-service-context.js",
    "test": "jest --runInBand",
    "test:db": "node -e \"const{Client}=require('pg');const c=new Client({host:'localhost',port:5432,user:'root',password:'1234',database:'postgres'});c.connect().then(async()=>{for(const d of ['api_server_test','api_server_http_test']){try{await c.query('CREATE DATABASE '+d);console.log('Created',d)}catch(e){console.log(d,'exists')}}await c.end()})\"",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:auto": "npm run typeorm migration:generate -- -d ./src/config/typeorm.config.ts ./src/typeorm/migrations/auto",
    "migration:create": "npm run typeorm migration:create --",
    "migration:fake": "npm run migration:run -- --fake",
    "migration:revert": "npm run typeorm migration:revert",
    "migration:run": "npm run typeorm migration:run -- -d ./src/config/typeorm.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@casl/ability": "^6.5.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sentry/nestjs": "^10.69.0",
    "@supercharge/request-ip": "^1.2.0",
    "api-server-toolkit": "github:fwmakc/api-server-toolkit#v0.12.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "helmet": "^8.3.0",
    "js-yaml": "^4.1.0",
    "jwks-rsa": "^4.1.0",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-custom": "^1.1.1",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "passport-oauth2": "^1.8.0",
    "pg": "^8.22.0",
    "redoc-express": "^2.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "typeorm-transactional": "^0.5.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcryptjs": "^2.4.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.17.7",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/passport-google-oauth20": "^2.0.11",
    "@types/passport-jwt": "^3.0.8",
    "@types/passport-local": "^1.0.38",
    "@types/passport-oauth2": "^1.4.15",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^9.0.5",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "^29.5.0",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.4",
    "ts-jest": "^29.0.5",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "webpack": "^5.108.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^@src/(.*)$": "<rootDir>/$1",
      "^@config/(.*)$": "<rootDir>/config/$1"
    }
  }
}
