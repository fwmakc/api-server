NODE_ENV=development
IP=
PORT=5000
PREFIX=
ROOT_PATH=./

# Auth server (for JWT verification via JWKS)
AUTH_SERVER_URL=http://localhost:3001

# Internal API key for service-to-service calls
INTERNAL_API_KEY=

# Admin access (toolkit) — JWT field and value for admin-level routes
SUPERUSER_FIELD=isSuperuser
SUPERUSER_VALUE=true

# Owner relation (toolkit) — default relation name linking entities to their owner
OWNER_TABLE=account

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=api_server
DB_USER=root
DB_PASSWORD=
DB_SYNCHRONIZE=true
DB_LOG=false

# Documentation
SWAGGER_PREFIX=swagger
SWAGGER_PREFIX_REDOC=redoc
SWAGGER_TITLE=API Server
SWAGGER_DESCRIPTION=Domain CRUD server
SWAGGER_VERSION=1.0

# Infrastructure (optional)
SENTRY_DSN=
SENTRY_ENV=localhost
MORGAN_LOG_FORMAT=

# Performance monitoring (optional)
METRICS_ENABLE=

# Request timeout (ms, default 30000)
REQUEST_TIMEOUT=
